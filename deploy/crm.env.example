# /etc/intelreach-crm.env – created by deploy/install.sh.
# After editing:  sudo bash deploy/install.sh   (re-renders Asterisk + restarts the CRM)
# Twilio keys and SIP trunks / numbers are set in the CRM: Admin → Integrations and Admin → SIP trunks.

CRM_DOMAIN=dialer.intelreach.com
CRM_PUBLIC_URL=https://dialer.intelreach.com
CRM_PORT=8040
CRM_DB=/var/lib/intelreach-crm/crm.db
CRM_POOL_FILE=/etc/intelreach-crm/agent_pool.json
PUBLIC_IP=76.13.179.69

# Generated – shared by the CRM and the Asterisk dialplan / encrypts provider API keys
CRM_AST_SECRET=
CRM_SECRET_KEY=

# OPTIONAL fallback / one-time import (leave empty on new installs):
#  - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are used only while Admin → Integrations → Twilio is empty
#  - TWILIO_* / TELNYX_* SIP values are copied into Admin → SIP trunks on the first start, then ignored
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TERMINATION=
TWILIO_SIP_USER=
TWILIO_SIP_PASS=
TELNYX_SIP_HOST=sip.telnyx.com
TELNYX_SIP_USER=
TELNYX_SIP_PASS=

# Browser phones register with the existing IntelReach Asterisk
CRM_SIP_WSS=wss://pbx.intelreach.com/ws
CRM_SIP_DOMAIN=pbx.intelreach.com
CRM_SIP_INBOUND=sip:crm@76.13.179.69:5060;transport=udp

# TURN (copied from /etc/intelreach.env if it exists)
TURN_SECRET=
TURN_HOST=turn.intelreach.com


CRM_RECORDINGS=/var/spool/asterisk/monitor/crm
CRM_MEDIA=/var/lib/intelreach-crm/media
