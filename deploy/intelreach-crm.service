[Unit]
Description=IntelReach Calling CRM (FastAPI)
After=network.target asterisk.service

[Service]
User=intelreach-crm
Group=intelreach-crm
WorkingDirectory=/opt/intelreach-crm
EnvironmentFile=/etc/intelreach-crm.env
ExecStart=/opt/intelreach-crm/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${CRM_PORT} --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
